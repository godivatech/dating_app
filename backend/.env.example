# ─────────────────────────────────────────────────────────────────────────────
# Backend Environment Variables
#
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to Git.
#
# .env.development  — local development
# .env.test         — test environment
# .env.production   — production (managed securely, never in Git)
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local development: use values matching infrastructure/docker-compose.yml
DATABASE_URL=postgresql://dating_app:local_dev_password_change_in_prod@localhost:5432/dating_app_dev

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a secure random secret for JWT signing.
# Example (bash): openssl rand -hex 64
# NEVER use this placeholder in production.
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SECRET_MINIMUM_64_CHARS

# JWT token expiry durations
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ── Cloudflare R2 (future phase) ─────────────────────────────────────────────
# These are documented here for planning purposes.
# Do NOT populate these until the media upload phase is implemented.
# NEVER put R2 credentials in the mobile app.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
