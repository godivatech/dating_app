# ─────────────────────────────────────────────────────────────────────────────
# Backend Environment Variables
#
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to Git.
#
# .env.development  — local development
# .env.test         — test environment
# .env.production   — production (managed securely, never in Git)
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (PostgreSQL) ────────────────────────────────────────────────────
# Local development: use values matching infrastructure/docker-compose.yml
DATABASE_URL=postgresql://dating_app:local_dev_password_change_in_prod@localhost:5432/dating_app_dev

# ── Redis ────────────────────────────────────────────────────────────────────
# Used for rate-limiting, cooldowns, and caching.
# Required in production. In-memory fallback available only in development/test.
REDIS_URL=redis://localhost:6379

# ── Authentication & Security ────────────────────────────────────────────────
# Secret for signing short-lived Access JWTs (minimum 64 characters)
JWT_ACCESS_SECRET=REPLACE_WITH_SECURE_RANDOM_ACCESS_SECRET_MIN_64_CHARS

# Access token expiry duration (e.g. 15m)
ACCESS_TOKEN_EXPIRES_IN=15m

# Refresh token expiry duration in days (e.g. 30)
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Server-side secret pepper for HMAC-SHA256 OTP hashing
# Exists ONLY on the backend server, never committed to Git, never stored in DB
OTP_PEPPER=REPLACE_WITH_SECURE_RANDOM_OTP_PEPPER_SECRET_MIN_64_CHARS

# OTP expiration in seconds (default: 300 = 5 minutes)
OTP_EXPIRY_SECONDS=300

# Maximum failed OTP verification attempts before challenge is invalidated (default: 3)
OTP_MAX_ATTEMPTS=3

# SMS Provider ('mock' for development/testing, or production provider)
SMS_PROVIDER=mock

# ── Cloudflare R2 (future phase) ─────────────────────────────────────────────
# These are documented here for planning purposes.
# Do NOT populate these until the media upload phase is implemented.
# NEVER put R2 credentials in the mobile app.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=
