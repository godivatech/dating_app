# ─────────────────────────────────────────────────────────────────────────────
# Mobile App Environment Variables
#
# Copy this file to .env and fill in values for your environment.
# NEVER commit .env to Git.
#
# Expo environment variables must be prefixed with EXPO_PUBLIC_
# to be available in the JavaScript bundle.
#
# WARNING: All EXPO_PUBLIC_ variables are bundled into the app binary and
# are visible to anyone who decompiles the app. Never put secrets here.
# ─────────────────────────────────────────────────────────────────────────────

# API base URL for the backend
# Development: http://localhost:3000
# Production: https://api.your-domain.com (set during build)
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
